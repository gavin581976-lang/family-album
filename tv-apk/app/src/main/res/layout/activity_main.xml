<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="家庭相册 · 屏保轮播"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="服务端地址(极空间 NAS 的 IP + 端口)"
            android:textColor="#AAAAAA"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etServer"
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:hint="http://192.168.1.100:8787"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="每张照片停留秒数"
            android:textColor="#AAAAAA"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etInterval"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="8"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/cbMute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:text="视频静音播放"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="测试连接" />

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="开始播放" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text=""
            android:textColor="#8BC34A"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:lineSpacingExtra="6dp"
            android:text="◆ 开启屏保自动轮播:\n电视设置 → 屏保(或「待机显示」) → 选择「家庭相册屏保」\n之后电视闲置时自动进入全屏轮播,按遥控器任意键退出。\n\n◆ 视频无法播放?多为编码问题(如 hevc),转成 mp4(h264) 后即可。"
            android:textColor="#888888"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
